# Netlify routing (works for drag-and-drop and Git deploys).
# Real files (index.html, admin.html, assets…) are always served first.

# Staff portal:   yoursite.netlify.app/admin
/admin     /admin.html   200

# A missing file under /assets must be a real 404, never the redirect page
# (browsers cache /assets for 7 days, so a wrong answer would stick)
/assets/*  /404.html     404

# Everything else goes to go.html:
#   yoursite.netlify.app/abc123   → short link redirect
#   yoursite.netlify.app/@name    → profile page
/*         /go.html      200
